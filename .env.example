MELU_ADDR=:8787
MELU_DATABASE_URL=postgres://melu:melu@localhost:5434/melu?sslmode=disable

# El puerto del front, no el del binario: es contra esto que se arma el redirect de Google, y
# en desarrollo el front vive en el 5173 con un proxy de /api al 8787. Con el 8787 el login
# funciona pero te deja parado en el puerto del binario, sirviendo el build de la última vez.
MELU_BASE_URL=http://localhost:5173

# Google es la única forma de entrar: sin esto el servidor no arranca. Se sacan de Google Cloud
# Console → Credentials → OAuth client ID, tipo «Web application», registrando como redirect URI
# http://localhost:5173/api/auth/google/callback (y el del 8787, si vas a correr el binario solo).
MELU_GOOGLE_CLIENT_ID=
MELU_GOOGLE_CLIENT_SECRET=

MELU_DEMO=1
